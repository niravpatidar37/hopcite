# Copy to .env and fill in. Never commit .env.
# Shared LLM secrets live outside the repo; point at them here.
PORTFOLIO_ENV_FILE=F:/.secrets/portfolio.env

# Local stack credentials (any random strings; used by docker-compose.yml and the app)
NEO4J_PASSWORD=
POSTGRES_PASSWORD=
# Password of kgrag_app, the API's least-privilege runtime DB user in the compose stack
# (docker/db-roles.sql creates it; R__grants.sql grants it only what the API needs).
PG_APP_PASSWORD=

# Connection settings (defaults shown)
NEO4J_URI=bolt://127.0.0.1:17687
PG_HOST=127.0.0.1
PG_PORT=15432

# SEC EDGAR requires a descriptive User-Agent with a real contact email.
# EDGAR rejects users.noreply.github.com addresses (HTTP 403), so set your own.
SEC_USER_AGENT=

# API key(s) required for every /ask call when set (comma-separated for rotation, each >= 16 chars).
# When unset, only loopback clients are served, and the API refuses to start on a non-loopback KGRAG_HOST.
KGRAG_API_KEY=

# Production controls (defaults shown)
# KGRAG_HOST=127.0.0.1
# KGRAG_PORT=8101                 # Cloud Run's PORT is used when KGRAG_PORT is unset
# KGRAG_KILL_SWITCH=0             # 1 = /ask answers 503 and every LLM call is refused
# KGRAG_ENV=dev                   # dev | ci | test | staging | prod (staging/prod enforce shared limits)
# KGRAG_RATE_LIMIT_PER_MIN=30     # per API key / client; 0 disables
# KGRAG_RATE_LIMIT_BURST=10
# KGRAG_RATE_LIMIT_BACKEND=memory # memory (one process) | postgres (shared by all instances; required in staging/prod)
# KGRAG_SPEND_BACKEND=file        # file (JSONL ledger, LLM_SPEND_LEDGER) | postgres (shared table; required in staging/prod)
# KGRAG_LLM_MODE=                 # fake = deterministic stand-in LLM for the CI smoke stack; refused unless KGRAG_ENV is dev/ci/test
# KGRAG_ROUTING_LOG=file          # file | postgres | stdout | off
# KGRAG_LLM_CACHE=1
# KGRAG_LOG_FORMAT=json           # json | text
# KGRAG_LOAD_DOTENV=1             # containers set 0: env vars / Secret Manager only
# NEO4J_USER=neo4j
# NEO4J_DATABASE=neo4j
# PG_USER=kgrag
# PG_DB=kgrag
# PG_SSLMODE=prefer               # Cloud Run: require

# Provided by PORTFOLIO_ENV_FILE (names only): GROQ_API_KEY, HF_TOKEN, LLM_SPEND_CAP_USD, LLM_SPEND_LEDGER
# Optional: ANTHROPIC_API_KEY enables the Claude adapter (still behind the spend cap).
