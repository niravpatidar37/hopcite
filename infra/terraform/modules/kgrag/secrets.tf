# Secret Manager: Terraform creates the secret *containers* only. Values are added out of band
# (`gcloud secrets versions add`, see docs/RUNBOOK.md) or, for the two database passwords, written
# through write-only arguments in sql.tf. No secret value is ever in Terraform code, plan or state.
#
# Neo4j has no managed GCP offering: the graph runs on Neo4j AuraDB (external dependency, reached
# over TLS at neo4j+s://...); its URI, user and password live here.

locals {
  secrets = {
    "api-key"           = "Comma-separated API keys accepted by POST /ask (KGRAG_API_KEY), each >= 16 chars."
    "groq-api-key"      = "Groq API key for the router and answer models."
    "neo4j-uri"         = "Neo4j AuraDB connection URI (neo4j+s://<id>.databases.neo4j.io)."
    "neo4j-user"        = "Neo4j AuraDB user."
    "neo4j-password"    = "Neo4j AuraDB password."
    "pg-app-password"   = "Cloud SQL password for kgrag_app (generated by Terraform, write-only)."
    "pg-owner-password" = "Cloud SQL password for kgrag_owner (generated by Terraform, write-only)."
  }

  # Least privilege: which runtime identity may read which secret.
  secret_readers = {
    "api-key"           = ["api"]
    "groq-api-key"      = ["api", "jobs"]
    "neo4j-uri"         = ["api", "jobs"]
    "neo4j-user"        = ["api", "jobs"]
    "neo4j-password"    = ["api", "jobs"]
    "pg-app-password"   = ["api"]
    "pg-owner-password" = ["jobs"]
  }

  secret_bindings = merge([
    for secret, readers in local.secret_readers : {
      for r in readers : "${secret}:${r}" => { secret = secret, reader = r }
    }
  ]...)
}

resource "google_secret_manager_secret" "s" {
  for_each = local.secrets

  # checkov:skip=CKV_GCP_84:Google-managed encryption keys; CMEK (Cloud KMS) is a documented hardening step, not required for this data class (public filings).
  project   = var.project_id
  secret_id = "${local.name}-${each.key}"
  labels    = local.labels

  annotations = {
    description = each.value
  }

  replication {
    auto {}
  }

  depends_on = [google_project_service.apis]
}

resource "google_secret_manager_secret_iam_member" "readers" {
  for_each = local.secret_bindings

  project   = var.project_id
  secret_id = google_secret_manager_secret.s[each.value.secret].secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = each.value.reader == "api" ? google_service_account.api.member : google_service_account.jobs.member
}
